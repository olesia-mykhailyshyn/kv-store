# YCSB parameters for the M2 baseline (design decision 11, task 13.1).
# Format: Java properties, passed to YCSB with -P after the workload file, so these win.
# Starting values; adjust after a trial run and keep the file with the results.
recordcount=100000
operationcount=200000
threadcount=8

# Our PUT replaces the whole item, so an update must send all fields (see bench/ycsb-binding/README.md).
writeallfields=true
readallfields=true

# Latency percentiles (p95, p99) in the output.
measurementtype=hdrhistogram

# Binding: table and partition key attribute (the table is created by scripts/ycsb-run.sh).
kv.table=usertable
kv.pk=ycsb_key
kv.timeout.ms=10000
